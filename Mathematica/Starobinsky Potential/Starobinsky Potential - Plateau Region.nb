     RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Phi]/M_{Pl}\>\"", ",", "\"\<V(\[Phi])\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Starobinsky Potential - Plateau Region\>\"", ",", "16"}], 
     "]"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
