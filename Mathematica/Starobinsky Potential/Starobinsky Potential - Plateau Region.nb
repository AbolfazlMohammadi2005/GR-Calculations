Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"MPl", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V", "[", "phi_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"3", " ", 
      RowBox[{"MPl", "^", "2"}], " ", 
      RowBox[{"M", "^", "2"}]}], ")"}], "/", "4"}], " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", "/", "3"}], "]"}]}], " ", 
        RowBox[{"phi", "/", "MPl"}]}], "]"}]}], ")"}], "^", "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vinf", "=", 
   RowBox[{"3", "/", "4"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"V", "[", "phi", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"phi", ",", "2", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
