   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0.7", ",", "0.76"}], "}"}]}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Red", ",", "Thick", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "Vinf"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"10", ",", "Vinf"}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
      
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<V(\[Infinity]) = 3/4 M_{Pl}^2 M^2\>\"", ",", "Red", ",",
           "14"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "0.752"}], "}"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Extremely flat plateau\>\"", ",", 
          RowBox[{"Darker", "[", "Green", "]"}], ",", "14", ",", "Bold"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "0.718"}], "}"}]}], "]"}], ",", 
      RowBox[{"Arrow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"6", ",", "0.722"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "0.735"}], "}"}]}], "}"}], "]"}]}], "}"}]}]}], 
  "]"}], "\n"}], "Input",
