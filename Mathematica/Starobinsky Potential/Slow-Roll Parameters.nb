     RowBox[{"{", 
      RowBox[{"0", ",", "0.5"}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<\[Epsilon]_V(\[Phi])\>\"", 
         ",", "\"\<-\[Eta]_V(\[Phi])\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", "0.8"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"Epilog", "->", 
