          RowBox[{"\"\<Inflation: \\!\\(\\*SubscriptBox[\\(\[Epsilon]\\), \
\\(V\\)]\\) < 1, |\\!\\(\\*SubscriptBox[\\(\[Eta]\\), \\(V\\)]\\)| < 1\>\"", ",", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", "14"}], "]"}], ",", 
