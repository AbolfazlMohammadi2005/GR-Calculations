Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"MPl", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "phi_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", " ", 
       RowBox[{"MPl", "^", "2"}], " ", 
       RowBox[{"M", "^", "2"}]}], ")"}], "/", "4"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "/", "3"}], "]"}]}], " ", 
         RowBox[{"phi", "/", "MPl"}]}], "]"}]}], ")"}], "^", "2"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vp", "[", "phi_", "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"V", "[", "phi", "]"}], ",", "phi"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vpp", "[", "phi_", "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"V", "[", "phi", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"phi", ",", "2"}], "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilonV", "[", "phi_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"MPl", "^", "2"}], "/", "2"}], ")"}], " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Vp", "[", "phi", "]"}], "/", 
      RowBox[{"V", "[", "phi", "]"}]}], ")"}], "^", "2"}]}]}], "\n", 
 RowBox[{
  RowBox[{"etaV", "[", "phi_", "]"}], ":=", 
  RowBox[{
   RowBox[{"MPl", "^", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Vpp", "[", "phi", "]"}], "/", 
     RowBox[{"V", "[", "phi", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilonV", "[", "phi_", "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"MPl", "^", "2"}], "/", "2"}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Vp", "[", "phi", "]"}], "/", 
       RowBox[{"V", "[", "phi", "]"}]}], ")"}], "^", "2"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"etaV", "[", "phi_", "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"MPl", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Vpp", "[", "phi", "]"}], "/", 
      RowBox[{"V", "[", "phi", "]"}]}], ")"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"epsilonV", "[", "phi", "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"etaV", "[", "phi", "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"phi", ",", "0", ",", "10"}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", "\"\<\[Phi]/M_{Pl}\>\"", "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", 
