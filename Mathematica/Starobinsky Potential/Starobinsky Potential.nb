      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Red", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", 
             RowBox[{"3", "/", "4"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"10", ",", 
             RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
